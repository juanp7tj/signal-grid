          <span>AG?NCIA / WORKSPACE 01</span>
          <ChevronRight size={13} />
        </div>

        <nav className="side-nav">
          <span className="nav-caption">WORKSPACE</span>
          <button
            className={activeTab === "overview" ? "active" : ""}
            onClick={() => {
              setActiveTab("overview");
              setSidebarOpen(false);
            }}
          >
            <BarChart3 size={17} /> Vis?o geral <span className="nav-key">01</span>
          </button>
          <button
            className={activeTab === "compare" ? "active" : ""}
            onClick={() => {
              setActiveTab("compare");
              setSidebarOpen(false);
            }}
          >
            <Layers3 size={17} /> {single ? "Perfil" : "Comparar perfis"}{" "}
            <span className="nav-key">02</span>
          </button>
          <button
            className={activeTab === "actions" ? "active" : ""}
            onClick={() => {
              setActiveTab("actions");
              setSidebarOpen(false);
            }}
          >
            <Target size={17} /> Plano de a??o <span className="nav-key">03</span>
          </button>

          <span className="nav-caption nav-caption-spaced">SISTEMA</span>
          <button onClick={() => setShowSettings(true)}>
            <Settings2 size={17} /> Personaliza??o
          </button>
        </nav>

        <div className="sidebar-bottom">
          <div className="status-indicator">
            <span className="pulse-dot" />
            <div>
              <strong>AGENT</strong>
              <small>Groq ? GPT-OSS 120B</small>
            </div>
          </div>
          <div className="sidebar-foot">
            <span>BUILD 1.1.0</span>
            <span>PT-BR</span>
          </div>
        </div>
      </aside>

      {sidebarOpen && (
        <button
          className="mobile-overlay"
          aria-label="Fechar menu"
          onClick={() => setSidebarOpen(false)}
        />
      )}

      <main className="main-canvas">
        <header className="topbar">
          <div className="topbar-left">
            <button
              className="menu-toggle"
              onClick={() => setSidebarOpen(true)}
              aria-label="Abrir menu"
            >
              <Menu size={19} />
            </button>
            <span className="breadcrumb">
              Workspace <ChevronRight size={13} />{" "}
              <strong>
                {activeTab === "compare"
                  ? single
                    ? "Perfil"
                    : "Compara??o"
                  : activeTab === "actions"
                  ? "Plano de a??o"
                  : "Vis?o geral"}
              </strong>
            </span>
          </div>
          <div className="topbar-right">
                        <button
              className="icon-button"
              title="Hist?rico de an?lises"
              onClick={() => {
                setHistoryOpen(true);
                loadHistory();
              }}
            >
              <History size={17} />
            </button>
            <span className="system-status">
              <span className="pulse-dot" /> SISTEMA OPERACIONAL
            </span>
            <button
              className="icon-button"
              title="Personaliza??o"
              onClick={() => setShowSettings(true)}
            >
              <SlidersHorizontal size={17} />
            </button>
            <div className="avatar">SG</div>
          </div>
        </header>

        <div className="page-content">
          {/* ?? TOGGLE DE MODO ? primeira coisa vis?vel */}
          <ModeToggle mode={mode} onChange={handleModeChange} />

          <section className="hero-row">
            <div>
