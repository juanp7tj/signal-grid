/* =========================================================
   Helpers
   ========================================================= */
function validInstagramUrl(value: string): boolean {
  try {
    const u = new URL(value);
    return ["instagram.com", "www.instagram.com"].includes(u.hostname);
  } catch {
    return false;
  }
}

function formatDate(iso: string): string {
  try {
    return new Date(iso).toLocaleString("pt-BR", {
      day: "2-digit",
      month: "long",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  } catch {
    return iso;
  }
}

/* =========================================================
   Subcomponentes b?sicos
   ========================================================= */
function ScoreBar({ label, value }: { label: string; value: number }) {
  return (
    <div className="score-row">
      <div className="score-row-label">
        <span>{label}</span>
        <strong>
          {value.toFixed(1)}
          <small>/10</small>
        </strong>
      </div>
      <div className="bar">
        <span style={{ width: `${Math.max(0, Math.min(10, value)) * 10}%` }} />
      </div>
    </div>
  );
}

function ProfileForm({
  label,
  profile,
  onChange,
}: {
  label: string;
  profile: ProfileInput;
  onChange: (v: ProfileInput) => void;
}) {
  const set = (key: keyof ProfileInput, value: string) =>
    onChange({ ...profile, [key]: value });

  return (
    <section className="profile-form">
      <div className="profile-form-head">
        <span className="eyebrow">{label}</span>
        <span className="profile-chip">
          <Instagram size={13} /> Instagram
        </span>
      </div>
      <label>
        Nome de refer?ncia
        <input
          value={profile.name}
          onChange={(e) => set("name", e.target.value)}
          placeholder="Ex.: Marca A"
          required
        />
      </label>
      <label>
        URL do perfil
        <input
          value={profile.url}
          onChange={(e) => set("url", e.target.value)}
          placeholder="https://instagram.com/usuario"
          required
        />
      </label>
      <label>
        Nicho
        <input
          value={profile.niche}
          onChange={(e) => set("niche", e.target.value)}
          placeholder="Ex.: est?tica, tecnologia"
        />
      </label>
      <label>
        P?blico-alvo
        <input
          value={profile.audience}
          onChange={(e) => set("audience", e.target.value)}
          placeholder="Quem a marca deseja alcan?ar?"
        />
      </label>
      <label>
        Objetivo principal
        <select
          value={profile.objective}
          onChange={(e) => set("objective", e.target.value)}
        >
          <option>Gerar leads</option>
          <option>Vender produtos</option>
          <option>Construir autoridade</option>
          <option>Aumentar alcance</option>
          <option>Construir comunidade</option>
        </select>
      </label>
    </section>
  );
}

function ActionCard({ item, index }: { item: ActionItem; index: number }) {
  const [open, setOpen] = useState(index === 0);

  return (
    <article className={`action-card ${open ? "expanded" : ""}`}>
      <button
        className="action-head"
        onClick={() => setOpen(!open)}
        aria-expanded={open}
      >
        <span className="action-number">
          {String(index + 1).padStart(2, "0")}
        </span>
        <span className="action-title-wrap">
          <span className={`priority ${item.priority.toLowerCase()}`}>
            {item.priority} prioridade
          </span>
          <strong>{item.title}</strong>
          <small>{item.reason}</small>
        </span>
        <ChevronRight className={open ? "rotated" : ""} size={18} />
      </button>

      {open && (
        <div className="action-details">
          <div>
            <span className="eyebrow">ETAPAS</span>
            <ol>
              {item.steps.map((s, i) => (
                <li key={i}>{s}</li>
              ))}
            </ol>
          </div>
          <div className="action-meta">
            <div className="metric-box">
              <Target size={16} />
              <span>
                <small>M?TRICA DE CONCLUS?O</small>
                <strong>{item.metric}</strong>
              </span>
            </div>
            <div className="meta-grid">
              <div>
                <small>PRAZO</small>
                <strong>{item.deadline}</strong>
              </div>
              <div>
                <small>RESPONS?VEL</small>
                <strong>{item.owner}</strong>
              </div>
              <div className="meta-wide">
                <small>KPI</small>
                <strong>{item.kpi}</strong>
              </div>
            </div>
          </div>
        </div>
      )}
    </article>
  );
}

/* =========================================================
   Toggle de modo (topo da p?gina)
   ========================================================= */
function ModeToggle({
  mode,
  onChange,
}: {
  mode: AnalysisMode;
  onChange: (m: AnalysisMode) => void;
}) {
  return (
    <section className="mode-toggle-wrap">
      <div className="mode-toggle">
        <button
          type="button"
          className={`mode-option ${mode === "single" ? "active" : ""}`}
          onClick={() => onChange("single")}
          aria-pressed={mode === "single"}
        >
          <span className="mode-option-label">AN?LISE ?NICA</span>
          <span className="mode-option-desc">1 perfil ? diagn?stico individual</span>
        </button>
        <button
          type="button"
          className={`mode-option ${mode === "compare" ? "active" : ""}`}
          onClick={() => onChange("compare")}
          aria-pressed={mode === "compare"}
        >
          <span className="mode-option-label">COMPARA??O</span>
          <span className="mode-option-desc">2 perfis ? diagn?stico competitivo</span>
        </button>
      </div>
    </section>
  );
}

/* =========================================================
   Action Plan Tabs (s? modo compara??o)
   ========================================================= */
function ActionPlanTabs({ report }: { report: AnalysisReport }) {
  const [tab, setTab] = useState<"A" | "B">("A");

  const profileA = report.profiles[0];
  const profileB = report.profiles[1];

  const planA = report.actionPlanA ?? [];
  const planB = report.actionPlanB ?? [];

  const items = tab === "A" ? planA : planB;
  const profileName = tab === "A" ? profileA?.profileName : profileB?.profileName;

  return (
    <div className="action-tabs">
      <div className="action-tabs-header">
        <button
          className={`action-tab ${tab === "A" ? "active" : ""}`}
          onClick={() => setTab("A")}
          type="button"
        >
          <span className="action-tab-label">PLANO A</span>
          <strong>{profileA?.profileName || "Perfil A"}</strong>
          <span className="action-tab-count">{planA.length} a??es</span>
        </button>
        <button
          className={`action-tab ${tab === "B" ? "active" : ""}`}
          onClick={() => setTab("B")}
          type="button"
        >
          <span className="action-tab-label">PLANO B</span>
          <strong>{profileB?.profileName || "Perfil B"}</strong>
          <span className="action-tab-count">{planB.length} a??es</span>
        </button>
      </div>

      <div className="action-tabs-body">
        {items.length === 0 ? (
          <div className="action-empty">
            Nenhuma a??o gerada para <strong>{profileName}</strong>.
          </div>
        ) : (
          <div className="action-list">
            {items.map((item, i) => (
              <ActionCard item={item} index={i} key={`${tab}-${i}-${item.title}`} />
            ))}
          </div>
        )}
      </div>
    </div>
  );
}

/* =========================================================
   Report Print View (usado s? na impress?o)
   ========================================================= */
function ReportPrintView({ report }: { report: AnalysisReport }) {
  const [leader, second] = report.profiles;
  const single = report.analysisMode === "single";

  return (
    <div id="print-report" aria-hidden="true">
      <header className="print-header">
        <div className="print-brand">
          <span className="print-mark">//SG</span>
          <div>
            <strong>SIGNAL GRID</strong>
            <small>Competitive Intelligence Report</small>
          </div>
        </div>
        <div className="print-meta">
          <span>{formatDate(report.generatedAt)}</span>
          <span className={`mode-tag ${report.mode}`}>
            {report.mode === "demo" ? "DEMONSTRA??O" : report.mode.toUpperCase()}
          </span>
        </div>
      </header>

      <section className="print-section">
        <h1>{report.title}</h1>
        <p className="print-summary">{report.summary}</p>
      </section>

      {/* Modo COMPARE ? vis?o geral + pilares */}
      {!single && (
        <>
          <section className="print-section">
            <h2>01 ? Vis?o geral</h2>
            <div className="print-overview">
              <div className="print-leader">
                <small>PERFIL L?DER</small>
                <strong>{leader?.profileName ?? "?"}</strong>
                <div className="print-score">
                  {leader?.overall.toFixed(1)}
                  <small>/10</small>
                </div>
                <p>
                  Vantagem de{" "}
                  <strong>
                    {leader && second
                      ? (leader.overall - second.overall).toFixed(1)
                      : "0.0"}{" "}
                    pts
                  </strong>{" "}
                  sobre {second?.profileName}.
                </p>
              </div>

              <div className="print-rank">
                <small>RANKING</small>
                <ol>
                  {(report.ranking ?? []).map((name, i) => {
                    const p = report.profiles.find((x) => x.profileName === name);
                    return (
                      <li key={name}>
                        <span className="print-rank-num">
                          {String(i + 1).padStart(2, "0")}
                        </span>
                        <span>{name}</span>
                        <strong>{p?.overall.toFixed(1)}</strong>
                      </li>
                    );
                  })}
                </ol>
              </div>
            </div>
          </section>

          <section className="print-section">
            <h2>02 ? Compara??o por pilares</h2>
            <table className="print-table">
              <thead>
                <tr>
                  <th>Dimens?o</th>
                  <th>{report.profiles[0]?.profileName}</th>
                  <th>{report.profiles[1]?.profileName}</th>
                </tr>
              </thead>
              <tbody>
                {(
                  [
                    ["Conte?do", "content"],
                    ["Consist?ncia", "consistency"],
                    ["Posicionamento", "positioning"],
                    ["Engajamento", "engagement"],
                    ["Geral", "overall"],
                  ] as const
                ).map(([label, key]) => (
                  <tr key={key}>
                    <td>{label}</td>
                    <td>{report.profiles[0]?.[key]?.toFixed(1) ?? "?"}</td>
                    <td>{report.profiles[1]?.[key]?.toFixed(1) ?? "?"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        </>
      )}

      {/* Modo SINGLE ? diagn?stico do perfil */}
      {single && (
        <section className="print-section">
          <h2>01 ? Diagn?stico do perfil</h2>
          <div className="print-overview">
            <div className="print-leader">
              <small>PERFIL</small>
              <strong>{leader?.profileName ?? "?"}</strong>
              <div className="print-score">
                {leader?.overall.toFixed(1)}
                <small>/10</small>
              </div>
            </div>
            <div className="print-rank">
              <small>PILARES</small>
              <ol>
                {(
                  [
                    ["Conte?do", "content"],
                    ["Consist?ncia", "consistency"],
                    ["Posicionamento", "positioning"],
                    ["Engajamento", "engagement"],
                  ] as const
                ).map(([label, key]) => (
                  <li key={key}>
                    <span className="print-rank-num">?</span>
                    <span>{label}</span>
                    <strong>{leader?.[key]?.toFixed(1) ?? "?"}</strong>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </section>
      )}

      {/* Oportunidades */}
      {report.opportunities.length > 0 && (
        <section className="print-section">
          <h2>{single ? "02" : "03"} ? Oportunidades priorit?rias</h2>
          <ol className="print-list">
            {report.opportunities.map((o, i) => (
              <li key={o.title}>
                <strong>
                  {String(i + 1).padStart(2, "0")} ? {o.title}
                </strong>
                <span className="print-impact">[{o.impact}]</span>
                <p>{o.description}</p>
              </li>
            ))}
          </ol>
        </section>
      )}

      {/* Plano de a??o */}
      <section className="print-section">
        <h2>{single ? "03" : "04"} ? Plano de a??o</h2>
        <ol className="print-actions">
          {(single
            ? report.actionPlan ?? []
            : [...(report.actionPlanA ?? []), ...(report.actionPlanB ?? [])]
          ).map((a, i) => (
            <li key={`${a.title}-${i}`}>
              <div className="print-action-head">
                <strong>
                  {String(i + 1).padStart(2, "0")} ? {a.title}
                </strong>
                <span className={`print-priority p-${a.priority.toLowerCase()}`}>
                  {a.priority}
                </span>
              </div>
              <p className="print-action-reason">{a.reason}</p>
              <div className="print-action-grid">
                <div>
                  <small>Prazo</small>
                  <strong>{a.deadline}</strong>
                </div>
                <div>
                  <small>Respons?vel</small>
                  <strong>{a.owner}</strong>
                </div>
                <div>
                  <small>KPI</small>
                  <strong>{a.kpi}</strong>
                </div>
              </div>
              <ol className="print-action-steps">
                {a.steps.map((s, si) => (
                  <li key={si}>{s}</li>
                ))}
              </ol>
            </li>
          ))}
        </ol>
      </section>

      {report.caveats.length > 0 && (
        <section className="print-section print-caveats">
          <h2>Limita??es e premissas</h2>
          {report.caveats.map((c, i) => (
            <p key={i}>? {c}</p>
          ))}
        </section>
      )}

      <footer className="print-footer">
        <span>SIGNAL GRID ? COMPETITIVE INTELLIGENCE</span>
        <span>Gerado em {formatDate(report.generatedAt)}</span>
      </footer>
    </div>
  );
}

/* =========================================================
   App principal
   ========================================================= */
export default function App() {
  const [mode, setMode] = useState<AnalysisMode>("compare");
  const [profileA, setProfileA] = useState(initialA);
  const [profileB, setProfileB] = useState(initialB);
  const [report, setReport] = useState<AnalysisReport | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const [progress, setProgress] = useState<string[]>([]);
  const [activeTab, setActiveTab] = useState("overview");
  const [showSettings, setShowSettings] = useState(false);
  const [sidebarOpen, setSidebarOpen] = useState(false);
  const [settings, setSettings] = useState<Settings>({
    language: "Portugu?s (Brasil)",
    tone: "Direto e estrat?gico",
    model: DEFAULT_MODEL,
  });
  const [evidence, setEvidence] = useState("");
  const [demoMode, setDemoMode] = useState(false);

  // ?? AQUI os tr?s novos
  const [historyOpen, setHistoryOpen] = useState(false);
  const [history, setHistory] = useState<HistorySummary[]>([]);
  const [historyLoading, setHistoryLoading] = useState(false);

  
    const scoreDiff = useMemo(() => {
    if (
      mode !== "compare" ||
      !report ||
      report.profiles.length < 2
    ) {
      return 0;
    }
    return report.profiles[0].overall - report.profiles[1].overall;
  }, [report, mode]);

  // Ao trocar de modo, limpa o relat?rio atual
  function handleModeChange(next: AnalysisMode) {
    if (next === mode) return;
    setMode(next);
    setReport(null);
    setError("");
    setProgress([]);
  }

  async function analyze() {
    setError("");
    setReport(null);
    setLoading(true);
    setProgress(["Validando briefing e URLs", "Preparando contexto estrat?gico"]);

    if (!validInstagramUrl(profileA.url)) {
      setError("Informe uma URL v?lida do Instagram.");
      setLoading(false);
      return;
    }
    if (mode === "compare" && !validInstagramUrl(profileB.url)) {
      setError("Informe a URL do segundo perfil do Instagram.");
      setLoading(false);
      return;
    }

    const timer = window.setTimeout(
      () =>
        setProgress((p) => [
          ...p,
          "Solicitando diagn?stico ao agente",
          "Estruturando notas e plano de a??o",
        ]),
      650
    );

    try {
      const response = await fetch("/api/analyze", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          analysisMode: mode,
          profileA,
          profileB: mode === "compare" ? profileB : null,
          settings,
          evidence,
          demoMode,
        }),
      });

      const data = await response.json();
      if (!response.ok) {
        throw new Error(data.error || "n?o foi poss?vel concluir a an?lise.");
      }
      setReport(data as AnalysisReport);
      setActiveTab("overview");
      setProgress((p) => [
        ...p,
        data.mode === "demo"
          ? "Modo demonstrativo ativado"
          : "An?lise conclu?da",
      ]);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Falha inesperada.");
    } finally {
      window.clearTimeout(timer);
      setLoading(false);
    }
  }

  function exportReport() {
    if (!report) return;
    document.body.classList.add("printing-report");
    window.print();
    window.setTimeout(() => {
      document.body.classList.remove("printing-report");
    }, 500);
  }

  const topScore = report?.profiles[0];
  const single = report?.analysisMode === "single";
  const compare = report?.analysisMode === "compare";
  /* =========================================================
     Hist?rico
     ========================================================= */
  async function loadHistory() {
    setHistoryLoading(true);
    try {
      const res = await fetch("/api/history");
      const text = await res.text();
      if (!text) return;
      const data = JSON.parse(text);
      if (data?.ok && Array.isArray(data.entries)) {
        setHistory(data.entries);
      }
    } catch (e) {
      console.warn("[history] falha ao carregar:", e);
    } finally {
      setHistoryLoading(false);
    }
  }

  async function openHistoryEntry(id: string, print = false) {
  try {
    const res = await fetch(`/api/history/${id}`);
    const text = await res.text();
    if (!text) return;
    const data = JSON.parse(text);
    if (data?.ok && data.entry?.report) {
      setReport(data.entry.report as AnalysisReport);
      setActiveTab("overview");
      setHistoryOpen(false);

      if (print) {
        // Aguarda o React renderizar o ReportPrintView antes de imprimir
        window.setTimeout(() => {
          document.body.classList.add("printing-report");
          window.print();
          window.setTimeout(() => {
            document.body.classList.remove("printing-report");
          }, 500);
        }, 300);
      } else {
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    }
  } catch (e) {
    console.warn("[history] falha ao abrir:", e);
  }
}

  async function deleteHistoryEntry(id: string) {
    try {
      await fetch(`/api/history/${id}`, { method: "DELETE" });
      setHistory((h) => h.filter((e) => e.id !== id));
    } catch (e) {
      console.warn("[history] falha ao apagar:", e);
    }
  }

  async function clearHistory() {
    if (!confirm("Apagar todo o hist?rico? Esta a??o n?o pode ser desfeita.")) {
      return;
    }
    try {
      await fetch("/api/history", { method: "DELETE" });
      setHistory([]);
    } catch (e) {
      console.warn("[history] falha ao limpar:", e);
    }
  }

  // Carrega o hist?rico na primeira renderiza??o
  useEffect(() => {
    loadHistory();
  }, []);

  return (
    <div className="app-shell">
      {report && <ReportPrintView report={report} />}

            <aside className={`sidebar ${sidebarOpen ? "sidebar-open" : ""}`}>
        <div className="brand">
          <div className="brand-mark">
            <span>//</span>SG
          </div>
          <div>
            <strong>SIGNAL GRID</strong>
            <small>COMPETITIVE INTELLIGENCE</small>
          </div>
          <button
            className="mobile-close"
            onClick={() => setSidebarOpen(false)}
            aria-label="Fechar menu"
          >
            <X size={18} />
          </button>
        </div>

        <div className="workspace">
