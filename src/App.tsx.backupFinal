                    ? "Cole observa??es sobre este perfil: frequ?ncia, formatos, tom, CTAs, prova social, bio. URLs sozinhas n?o fornecem essas informa??es."
                    : "Cole observa??es dos dois perfis: frequ?ncia, formatos, tom, CTAs, prova social, bio. URLs sozinhas n?o fornecem essas informa??es."
                }
              />
            </label>

            <div className="briefing-footer">
              <div className="briefing-note">
                <ShieldCheck size={16} />
